{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frontend-server-edge",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "frontend-server-edge"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Add an incremental cache binding to keep prerendered pages and cached
  // content fetches out of the render path. The per-boundary workers get this
  // generated from PORTAL_INCREMENTAL_CACHE_* (see
  // docs/architecture/content-caching.md); this single-worker target has to
  // declare it by hand, and runs without a cache until it does:
  //
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "<bucket>" }
  // ],
  "env": {
    "sit": {
      "name": "frontend-server-edge-sit",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "frontend-server-edge-sit"
        }
      ]
    },
    "uat": {
      "name": "frontend-server-edge-uat",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "frontend-server-edge-uat"
        }
      ]
    },
    "prod": {
      "name": "frontend-server-edge-prod",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "frontend-server-edge-prod"
        }
      ]
    }
  }
}
