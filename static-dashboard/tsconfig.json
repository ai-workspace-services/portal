{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "incremental": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "../types/**/*.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["../node_modules"]
}
