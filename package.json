{
  "name": "frontend-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.17 <25"
  },
  "scripts": {
    "dev": "bash scripts/Dev-MCP-Server.sh && next dev --turbo",
    "prebuild": "bash scripts/prebuild.sh",
    "build": "bash scripts/prebuild.sh && next build",
    "build:frontend-server:node": "yarn build",
    "build:static-dashboard": "SKIP_CONTENTLAYER=true bash scripts/prebuild.sh && next build static-dashboard",
    "preview:static-dashboard": "wrangler pages dev out --cwd static-dashboard",
    "deploy:static-dashboard:pages": "yarn build:static-dashboard && wrangler pages deploy out --cwd static-dashboard",
    "build:workers:next": "SKIP_CONTENTLAYER=true bash scripts/prebuild.sh && next build && node scripts/prepare-open-next-build.mjs",
    "build:workers": "yarn build:workers:next && opennextjs-cloudflare build --skipNextBuild --config wrangler.worker.jsonc",
    "preview:workers": "yarn build:workers && opennextjs-cloudflare preview --config wrangler.worker.jsonc",
    "build:frontend-server:worker": "yarn build:workers",
    "preview:frontend-server:worker": "yarn preview:workers",
    "deploy:frontend-server:worker": "yarn build:frontend-server:worker && opennextjs-cloudflare deploy --config wrangler.worker.jsonc",
    "build:static": "yarn build",
    "content:pull": "bash scripts/sync-content.sh pull",
    "content:validate": "tsx scripts/validate-website-content.ts",
    "start": "node ./scripts/start.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --no-eslintrc -c .eslintrc.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "preview": "next build && next start",
    "test": "vitest run --config tests/unit/vitest.config.ts",
    "test:unit": "vitest run --config tests/unit/vitest.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.956.0",
    "@floating-ui/dom": "^1.6.0",
    "@giscus/react": "^3.1.0",
    "@opennextjs/cloudflare": "1.18.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tiptap/core": "^3.13.0",
    "@tiptap/pm": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "contentlayer": "^0.3.4",
    "dompurify": "^3.2.6",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.319.0",
    "marked": "^16.1.2",
    "mermaid": "^11.12.2",
    "next": "^16.0.9",
    "next-contentlayer": "^0.3.4",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.2.67",
    "prismjs": "^1.30.0",
    "prop-types": "^15.8.1",
    "qr.js": "0.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.5.0",
    "react-grid-layout": "^1.4.4",
    "react-pdf": "^9.1.0",
    "react-resizable": "^3.0.4",
